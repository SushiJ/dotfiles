general {
        output_format = "i3bar"
        colors = true
        interval = 5
}

order += "disk /"
order += "disk /home"
order += "memory"
order += "load"
order += "ethernet enp34s0"
order += "time"

# wireless wlo1 {
        # format_up = "W: (%quality at %essid, %bitrate) %ip"
        # format_down = "W: down"
# }

ethernet enp34s0 {
         format_up = "%ip"
         format_down = "down"
}

memory {
        format = "%used / %total"
        threshold_degraded = "10%"
        format_degraded = "MEMORY: %free"
}

load {
        format = "load: %1min, %5min, %15min"
}

disk "/" {
        format = "%used / %total"
}

disk "/home" {
        format = "%used / %total"
}

time {
    format = "%a %d/%m/%Y %H:%M"
}
